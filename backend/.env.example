# === LLM ===
# 系统默认 LLM 的 API Key。用户没在 UI 配置自己的 LLM 时，后端用这个 key 调
# `DEFAULT_LLM_URL` / `DEFAULT_LLM_MODEL`（见 backend/constants.py，默认走 SiliconFlow
# 的 DeepSeek-V3）。后端支持三种 provider，前端 ⚙ LLM 配置弹窗里选：
#   * openai      — OpenAI 兼容协议（DeepSeek / SiliconFlow / Qwen / Kimi / 智谱 / Ollama）
#   * anthropic   — Claude Messages API
#   * gemini      — Google generateContent API
# 用户级 key 不写在 .env，而是登录后在 UI 配；这里的 DEEPSEEK_API_KEY 只是系统兜底。
DEEPSEEK_API_KEY=your_api_key_here

# === 必填 ===
# Flask Session 密钥。必须设置：未设置时后端拒绝启动。建议长度 ≥ 32：
#   openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# === 安全 ===
# 允许携带 cookie 跨域访问的前端来源，逗号分隔。默认仅本地前端。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 反向代理（nginx/Caddy）上 HTTPS 时设为 1，让 Set-Cookie 自动加 Secure 标记。
SESSION_COOKIE_SECURE=0

# 单次请求体上限（MB），主要影响 OCR 图片上传。
MAX_CONTENT_LENGTH_MB=8

# 用于派生 LLM API key 加密密钥的盐值（与 SECRET_KEY 一同决定密钥）。
# 一旦修改，已加密的 LLM key 会变成不可解密——请只在初始化时设置一次。
LLM_SECRET_SALT=ai-finance-llm-config

# 每用户每日 LLM total_tokens 上限。0 / 不设 = 不限。建议生产环境设置（例如 200000）
# 以避免账户失控刷 API 账单。
LLM_DAILY_TOKEN_LIMIT=0

# CSRF 校验开关。生产强烈建议保持启用；如需在受信内网/CLI 排错可设为 0。
CSRF_ENABLED=1

# === MCP / 其它 ===
# MCP 监听端口（默认 5001，一般无需修改）
MCP_PORT=5001

# MiniMax 图片识别（Token Plan，通过 MCP 调用）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MCP_PORT=5002

# === 运行时调优（一般保持默认即可） ===
# 集中日志目录，默认 backend/logs；改这里要确保进程对目录有写权限。
# LOG_DIR=backend/logs

# 月度报告异步生成的 worker 数。单用户连点 N 次不会重复跑（_inflight 去重），
# 多用户并发由 ThreadPool 排队。生产可根据 LLM 配额上调到 4-8。
# REPORT_WORKERS=2

# SQLite 文件路径，默认 backend/records.db。多实例部署/外挂数据卷时改这里。
# DB_FILE=backend/records.db
