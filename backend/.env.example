# LLM API 配置（默认使用 SiliconFlow / DeepSeek，也可替换为其他兼容 OpenAI 格式的服务）
DEEPSEEK_API_KEY=your_api_key_here

# === 必填 ===
# Flask Session 密钥。必须设置：未设置时后端拒绝启动。建议长度 ≥ 32：
#   openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# === 安全 ===
# 允许携带 cookie 跨域访问的前端来源，逗号分隔。默认仅本地前端。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 反向代理（nginx/Caddy）上 HTTPS 时设为 1，让 Set-Cookie 自动加 Secure 标记。
SESSION_COOKIE_SECURE=0

# 单次请求体上限（MB），主要影响 OCR 图片上传。
MAX_CONTENT_LENGTH_MB=8

# 用于派生 LLM API key 加密密钥的盐值（与 SECRET_KEY 一同决定密钥）。
# 一旦修改，已加密的 LLM key 会变成不可解密——请只在初始化时设置一次。
LLM_SECRET_SALT=ai-finance-llm-config

# === MCP / 其它 ===
# MCP 监听端口（默认 5001，一般无需修改）
MCP_PORT=5001

# MiniMax 图片识别（Token Plan，通过 MCP 调用）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MCP_PORT=5002
