# LLM API 配置（默认使用 SiliconFlow / DeepSeek，也可替换为其他兼容 OpenAI 格式的服务）
DEEPSEEK_API_KEY=your_api_key_here

# Flask Session 密钥（可随机生成，如 openssl rand -hex 32）
SECRET_KEY=your_secret_key_here

# MCP Server 配置
# MCP_API_KEY: 用于 MCP 接口的 Bearer 鉴权，填入任意字符串后在 MCP 客户端配置中使用同一值
MCP_API_KEY=your_mcp_api_key_here

# MCP_USER_ID: MCP 工具操作所归属的用户 ID（对应数据库 users 表的 id 字段）
# 默认为 1（初始化时自动创建的 admin 账号）
# 多用户场景：可在前端注册新用户后查看其 id，并按需修改此值
MCP_USER_ID=1

# MCP 监听端口（默认 5001，一般无需修改）
MCP_PORT=5001
