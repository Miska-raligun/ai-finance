# LLM API 配置（默认使用 SiliconFlow / DeepSeek，也可替换为其他兼容 OpenAI 格式的服务）
DEEPSEEK_API_KEY=your_api_key_here

# Flask Session 密钥（可随机生成，如 openssl rand -hex 32）
SECRET_KEY=your_secret_key_here

# MCP 监听端口（默认 5001，一般无需修改）
MCP_PORT=5001

# MiniMax 图片识别（Token Plan，通过 MCP 调用）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MCP_PORT=5002
